<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>幼儿园日报助手 · 本地版</title>
<meta name="theme-color" content="#4f7cff">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="日报助手">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<style>
:root{
  --bg:#f4f6fa;--card:#fff;--ink:#1f2937;--sub:#6b7280;--line:#e5e7eb;
  --brand:#4f7cff;--brand-soft:#eef2ff;--green:#16a34a;--green-soft:#e8f7ee;
  --yellow:#d97706;--yellow-soft:#fef6e4;--red:#dc2626;--red-soft:#fdecec;
  --purple:#7c3aed;--purple-soft:#f3ecfe;--radius:14px;--shadow:0 2px 10px rgba(31,41,55,.07);
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:"PingFang SC","Microsoft YaHei","Noto Sans CJK SC",sans-serif;background:var(--bg);color:var(--ink);padding-bottom:60px}
.wrap{max-width:1080px;margin:0 auto;padding:16px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px}
.brand{display:flex;align-items:center;gap:10px}
.brand .logo{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,#4f7cff,#7c3aed);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20px}
.brand h1{font-size:18px}
.brand small{display:block;font-size:11px;color:var(--sub);font-weight:400;margin-top:1px}
.top .ops{display:flex;gap:8px}
.btn{border:none;border-radius:11px;padding:10px 16px;font-size:13px;font-weight:600;cursor:pointer;transition:.15s;background:#fff;border:1.5px solid var(--line);color:var(--ink)}
.btn:hover{border-color:var(--brand);color:var(--brand)}
.btn-p{background:var(--brand);color:#fff;border-color:var(--brand)}
.btn-p:hover{background:#3b5bdb;color:#fff}
.btn-g{background:var(--green);color:#fff;border-color:var(--green)}
.btn-sm{padding:6px 12px;font-size:12px;border-radius:9px}
.tabs{display:flex;background:#fff;border-radius:999px;padding:4px;box-shadow:var(--shadow);margin-bottom:16px;width:fit-content}
.tabs button{border:none;background:transparent;padding:9px 20px;border-radius:999px;font-size:13.5px;color:var(--sub);cursor:pointer;font-weight:600}
.tabs button.on{background:var(--brand);color:#fff}
.card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px;margin-bottom:14px}
.card h3{font-size:15px;margin-bottom:12px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.tag{font-size:10.5px;font-weight:600;padding:3px 9px;border-radius:999px}
.b-blue{background:var(--brand-soft);color:#3b5bdb}.b-green{background:var(--green-soft);color:var(--green)}
.b-yellow{background:var(--yellow-soft);color:var(--yellow)}.b-red{background:var(--red-soft);color:var(--red)}
.b-purple{background:var(--purple-soft);color:var(--purple)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px}
.kid{border:1.5px solid var(--line);border-radius:12px;padding:10px;cursor:pointer;transition:.15s;background:#fff;position:relative}
.kid:hover{border-color:var(--brand)}
.kid.on{border-color:var(--brand);background:var(--brand-soft)}
.kid.done{border-color:var(--green)}
.kid.done::after{content:"✓";position:absolute;top:6px;right:8px;color:var(--green);font-weight:700;font-size:13px}
.kid .nm{font-size:13.5px;font-weight:600}
.kid .st{font-size:11px;color:var(--sub);margin-top:2px}
.kid .del{position:absolute;top:4px;right:4px;width:22px;height:22px;line-height:22px;text-align:center;border-radius:50%;background:#f3f4f6;color:#9ca3af;font-size:11px;border:none;cursor:pointer;opacity:.55}
.kid .del:hover{background:var(--red-soft);color:var(--red);opacity:1}
.kid .rec{font-size:10.5px;color:var(--sub);margin-top:3px}
.fl{font-size:12px;color:var(--sub);margin:14px 0 6px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.fl:first-child{margin-top:0}
.req{color:var(--red);font-weight:700}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{border:1.5px solid var(--line);background:#fff;border-radius:999px;padding:7px 14px;font-size:12.5px;cursor:pointer;transition:.15s;user-select:none}
.chip:hover{border-color:var(--brand)}
.chip.sel{background:var(--brand);border-color:var(--brand);color:#fff;font-weight:600}
.chip.sel.ok{background:var(--green);border-color:var(--green)}
.chip.sel.warn{background:var(--yellow);border-color:var(--yellow)}
.chip.sel.danger{background:var(--red);border-color:var(--red)}
input[type=text],input[type=number],textarea,select{width:100%;border:1.5px solid var(--line);border-radius:10px;padding:9px 11px;font-size:13px;font-family:inherit;color:var(--ink);background:#fff}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--brand)}
textarea{resize:vertical;min-height:60px;line-height:1.7}
.row2{display:flex;gap:10px}
.row2>*{flex:1}
.dim-note{margin-top:7px;font-size:12.5px!important;padding:7px 10px!important;border-style:dashed!important;background:#fcfdff!important;color:#374151}
.dim-note::placeholder{color:#b6bcc7;font-size:11.5px}
.out{background:#fafbfe;border:1.5px solid var(--line);border-radius:12px;padding:14px;font-size:13.5px;line-height:1.85;white-space:pre-wrap;word-break:break-word}
.out.red{background:var(--red-soft);border-color:#fca5a5}
.out.yellow{background:var(--yellow-soft);border-color:#fcd34d}
.warnbox{border-radius:11px;padding:11px 13px;font-size:12px;line-height:1.75;margin-bottom:12px}
.wb-red{background:var(--red-soft);color:#991b1b}
.wb-yellow{background:var(--yellow-soft);color:#92400e}
.wb-blue{background:var(--brand-soft);color:#3730a3}
.wb-green{background:var(--green-soft);color:#166534}
.stat{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px}
.stat .s{background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:12px;text-align:center;cursor:pointer;transition:.15s;user-select:none;-webkit-tap-highlight-color:transparent}
.stat .s:hover{border-color:var(--brand)}
.stat .s.sel{border-color:var(--brand);box-shadow:0 0 0 3px var(--brand-soft)}
.stat .s.sel .l{color:var(--brand);font-weight:700}
.stat .n{font-size:22px;font-weight:800}
.stat .l{font-size:11px;color:var(--sub);margin-top:2px}
.batch-item{border:1.5px solid var(--line);border-radius:12px;padding:13px;margin-bottom:10px;background:#fff}
.batch-item.red{border-color:#fca5a5;background:var(--red-soft)}
.batch-item.yellow{border-color:#fcd34d;background:var(--yellow-soft)}
.batch-item .hd{display:flex;align-items:center;gap:8px;margin-bottom:9px;flex-wrap:wrap}
.batch-item .hd .nm{font-weight:700;font-size:14px}
.batch-item .txt{font-size:12.5px;line-height:1.8;background:#fff;border-radius:10px;padding:11px;border:1px solid var(--line)}
.batch-item.red .txt,.batch-item.yellow .txt{border-color:transparent}
.batch-item .ops{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.empty{text-align:center;color:var(--sub);font-size:13px;padding:28px 0;line-height:1.9}
.page{display:none}.page.on{display:block}
.toast{position:fixed;left:50%;bottom:30px;transform:translateX(-50%);background:rgba(15,23,42,.93);color:#fff;padding:11px 22px;border-radius:999px;font-size:13px;opacity:0;pointer-events:none;transition:.3s;z-index:99}
.toast.show{opacity:1}
.mask{position:fixed;inset:0;background:rgba(15,23,42,.5);display:none;align-items:center;justify-content:center;z-index:50;padding:16px}
.mask.show{display:flex}
.modal{background:#fff;border-radius:18px;padding:22px;width:100%;max-width:460px;max-height:88vh;overflow-y:auto}
.modal h3{font-size:17px;margin-bottom:14px}
.modal .ops{display:flex;gap:8px;margin-top:16px}
hr{border:none;border-top:1px solid var(--line);margin:16px 0}
.hint{font-size:11.5px;color:var(--sub);line-height:1.75}
.copy-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
@media(max-width:640px){
.grid{grid-template-columns:repeat(2,1fr)}.row2{flex-direction:column}.wrap{padding:10px 12px calc(78px + env(safe-area-inset-bottom))}
/* App 化：底部固定导航栏 */
.tabs{position:fixed;left:0;right:0;bottom:0;top:auto;width:auto;display:flex;border-radius:0;margin:0;padding:6px 2px calc(6px + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 -2px 14px rgba(31,41,55,.1);border-top:1px solid var(--line);z-index:50;justify-content:space-around;overflow-x:auto;-webkit-overflow-scrolling:touch}
.tabs button{flex:1 0 auto;min-width:0;padding:4px 2px;font-size:9.5px;line-height:1.25;border-radius:9px;display:flex;flex-direction:column;align-items:center;gap:2px;color:var(--sub)}
.tabs button.on{background:var(--brand-soft);color:var(--brand)}
/* 加大触控目标 */
.chip{padding:9px 14px;font-size:13px;-webkit-tap-highlight-color:transparent}
.btn{padding:12px 16px;font-size:13.5px;-webkit-tap-highlight-color:transparent}
.btn-sm{padding:9px 13px}
input[type=text],input[type=number],textarea,select{padding:11px 12px;font-size:14px}
.kid{padding:13px 10px;-webkit-tap-highlight-color:transparent}
/* 顶部栏精简 */
.top{position:sticky;top:0;z-index:40;background:var(--bg);padding:10px 0 8px;margin-bottom:8px;border-radius:0}
.top .brand .logo{width:34px;height:34px;font-size:18px}
.top h1{font-size:15.5px}
.top small{font-size:9.5px;line-height:1.35}
.top .ops .btn{padding:7px 9px;font-size:11px}
.card{padding:14px;border-radius:12px}
/* 禁双击缩放 / 长按弹菜单（保留输入框可选中） */
.chip,.kid,.tabs button,.btn{-webkit-touch-callout:none;user-select:none;-webkit-user-select:none}
.dim-note,.out,textarea,input{-webkit-touch-callout:default;user-select:text;-webkit-user-select:text}
}
/* 独立窗口模式（添加到桌面后）：隐藏浏览器元素残留间距 */
@media(display-mode:standalone){.wrap{padding-top:calc(10px + env(safe-area-inset-top))}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div class="brand">
      <div class="logo">🧸</div>
      <div><h1>幼儿园日报助手</h1><small>个人自用本地版 · 数据只存在你自己浏览器里 · 无需服务器、无需资质</small></div>
    </div>
    <div class="ops">
      <button class="btn btn-sm" onclick="exportData()">💾 导出备份</button>
      <button class="btn btn-sm" onclick="document.getElementById('importFile').click()">📂 导入备份</button>
      <input type="file" id="importFile" accept=".json" class="hidden" style="display:none" onchange="importData(event)">
    </div>
  </div>

  <div class="tabs">
    <button class="on" onclick="go('pRoster',this)"><span>👶</span>名单</button>
    <button onclick="go('pInput',this)"><span>✏️</span>录入</button>
    <button onclick="go('pReport',this)"><span>📝</span>日报</button>
    <button onclick="go('pBatch',this)"><span>📋</span>批量</button>
    <button onclick="go('pWeekly',this)"><span>📊</span>周报</button>
    <button onclick="go('pNotice',this)"><span>📢</span>通知</button>
    <button onclick="go('pPhrases',this)"><span>🎨</span>文案库</button>
    <button onclick="go('pHelp',this)"><span>❓</span>用法</button>
  </div>

  <!-- 名单 -->
  <div class="page on" id="pRoster">
    <div class="card">
      <h3>👶 班级名单 <span class="tag b-blue" id="rosterCount">0 人</span></h3>
      <div class="warnbox wb-blue">名单只保存在<b>你这台设备的浏览器</b>里（localStorage）。不联网、不上传、不共享。换设备或清缓存前请先点右上角「导出备份」。</div>
      <div class="row2">
        <div><input type="text" id="newName" placeholder="孩子姓名，如：张小明"></div>
        <div style="flex:0 0 160px"><input type="text" id="newParent" placeholder="称呼，如：小明妈妈"></div>
        <div style="flex:0 0 110px"><button class="btn btn-p" onclick="addKid()">＋ 添加</button></div>
      </div>
      <div class="row2" style="margin-top:8px">
        <div><input type="text" id="newNick" placeholder="小名/别名（选填），如：明明、乐乐"></div>
        <div class="hint" style="flex:1;align-self:center">填了小名，日报里就用小名（更亲切）；不填则自动用姓名去掉姓氏（张小明 → 小明）</div>
      </div>
      <hr>
      <div class="grid" id="rosterGrid"></div>
      <hr>
      <div class="row2">
        <div><button class="btn btn-sm" onclick="openImportRoster()">📋 批量粘贴添加</button></div>
        <div><button class="btn btn-sm btn-p" onclick="document.getElementById('rosterFile').click()">📊 Excel 导入名单</button></div>
        <input type="file" id="rosterFile" accept=".csv,.tsv,.txt,.xlsx,.xls" style="display:none" onchange="importRosterFile(event)">
        <div><button class="btn btn-sm" onclick="loadDemo()">✨ 载入示例名单（7人）</button></div>
      </div>
      <div class="hint" style="margin-top:8px">Excel 导入：第一列<b>孩子姓名</b>、第二列<b>称呼</b>（如"小明妈妈"）、第三列<b>小名</b>（选填，如"明明"）。支持 .csv / .xlsx。导入前会先让你预览确认，可选择「仅新增」「新增并更新称呼」「以表格为准（移除表里没有的）」三种方式。<br><b>小名的作用：</b>填了小名，日报里就用小名称呼孩子（如"明明今天看起来比较累"）；不填则自动用姓名去掉姓氏（张小明 → "小明今天……"）。</div>
    </div>
  </div>

  <!-- 名单导入预览 -->
  <div class="mask" id="rosterMask">
    <div class="modal">
      <h3>名单导入预览</h3>
      <div class="warnbox wb-blue" id="rosterStat"></div>
      <div class="fl">导入方式</div>
      <div class="chips" id="rosterModeChips" data-single="1">
        <div class="chip sel">仅新增</div>
        <div class="chip">新增并更新称呼</div>
        <div class="chip warn">以表格为准</div>
      </div>
      <div class="hint" style="margin:8px 0">「以表格为准」会<b>移除表格里没有的孩子</b>（其历史记录一并删除），仅在你换了整份班级名单时使用。</div>
      <div style="max-height:220px;overflow:auto" id="rosterPreview"></div>
      <div class="ops">
        <button class="btn" style="flex:1" onclick="closeRosterModal()">取消</button>
        <button class="btn btn-p" style="flex:1" onclick="applyRosterImport()">✅ 确认导入</button>
      </div>
    </div>
  </div>

  <!-- 录入 -->
  <div class="page" id="pInput">
    <div class="card">
      <h3>✏️ 今日录入 <span class="tag b-blue" id="dateLabel"></span></h3>
      <div class="fl">选择日期（可补录前几天漏记的）</div>
      <div class="row2">
        <div><input type="date" id="datePick" onchange="changeDate()"></div>
        <div style="flex:0 0 110px"><button class="btn" onclick="backToday()">回到今天</button></div>
      </div>
      <div class="hint" id="dateHint" style="margin-bottom:8px"></div>
      <div class="warnbox wb-blue">全程<b>点选</b>，只有「今日亮点」和「需家长关注」需要打几个字。红色标记字段 AI 不会自动生成，必须你自己确认。</div>
      <div class="grid" id="pickKid"></div>
    </div>

    <div class="card" id="inputForm" style="display:none">
      <h3>✏️ <span id="curName"></span> · <span id="curParent" style="color:var(--sub);font-weight:400"></span></h3>

      <div class="fl">出勤状态 <span class="req">● 强制确认</span></div>
      <div class="chips" data-f="attendance" data-single="1">
        <div class="chip sel ok">正常出勤</div><div class="chip">请假</div><div class="chip warn">病假</div><div class="chip">迟到</div><div class="chip">早退</div>
      </div>
      <input type="text" id="note_attendance" class="dim-note" placeholder="补充说明（选填），如：9点才到，早上在家闹情绪">

      <div class="fl">精神活力</div>
      <div class="chips" data-f="energy" data-single="1">
        <div class="chip ok">非常活跃</div><div class="chip sel">正常</div><div class="chip warn">略蔫</div><div class="chip danger">明显疲惫</div>
      </div>
      <input type="text" id="note_energy" class="dim-note" placeholder="补充说明（选填），如：上午特别兴奋，下午有点犯困">

      <div class="fl">情绪基调</div>
      <div class="chips" data-f="mood" data-single="1">
        <div class="chip ok">愉快</div><div class="chip sel">平静</div><div class="chip warn">易烦躁</div><div class="chip warn">低落</div><div class="chip danger">哭闹</div>
      </div>
      <input type="text" id="note_mood" class="dim-note" placeholder="补充说明（选填），如：早上分离时哭了5分钟，抱一会儿就好">

      <div class="fl">早餐</div>
      <div class="chips" data-f="breakfast" data-single="1">
        <div class="chip ok">全部吃完</div><div class="chip sel">吃了大半</div><div class="chip">吃了一半</div><div class="chip warn">少量</div><div class="chip danger">未进食</div>
      </div>
      <input type="text" id="note_breakfast" class="dim-note" placeholder="补充说明（选填），如：今天有牛奶，喝完了">

      <div class="fl">午餐</div>
      <div class="chips" data-f="lunch" data-single="1">
        <div class="chip ok">全部吃完</div><div class="chip sel">吃了大半</div><div class="chip">吃了一半</div><div class="chip warn">少量</div><div class="chip danger">未进食</div>
      </div>
      <input type="text" id="note_lunch" class="dim-note" placeholder="补充说明（选填），如：今天的红烧肉很喜欢，主动添了一次">

      <div class="fl">午餐挑食项（可多选）</div>
      <div class="chips" data-f="pick">
        <div class="chip">蔬菜</div><div class="chip">肉类</div><div class="chip">主食</div><div class="chip">汤</div><div class="chip">水果</div><div class="chip sel">无</div>
      </div>
      <input type="text" id="note_pick" class="dim-note" placeholder="补充说明（选填），如：胡萝卜挑出来了，青菜愿意吃一口">

      <div class="fl">加餐</div>
      <div class="chips" data-f="snack" data-single="1">
        <div class="chip sel ok">正常</div><div class="chip warn">少量</div><div class="chip warn">未吃</div>
      </div>
      <input type="text" id="note_snack" class="dim-note" placeholder="补充说明（选填），如：今天点心是酸奶，很喜欢">

      <div class="fl">排便次数</div>
      <div class="chips" data-f="stoolCount" data-single="1">
        <div class="chip">0次</div><div class="chip sel ok">1次</div><div class="chip">2次</div><div class="chip">3次+</div>
      </div>
      <input type="text" id="note_stoolCount" class="dim-note" placeholder="补充说明（选填），如：上午集体如厕时">

      <div class="fl">排便性状 <span class="req">● 强制确认</span></div>
      <div class="chips" data-f="stoolStatus" data-single="1">
        <div class="chip sel ok">正常</div><div class="chip warn">偏干硬</div><div class="chip warn">偏稀</div><div class="chip danger">异常</div>
      </div>
      <input type="text" id="note_stoolStatus" class="dim-note" placeholder="补充说明（选填），如：比前两天好一些">

      <div class="fl">午睡情况</div>
      <div class="chips" data-f="nap" data-single="1">
        <div class="chip sel ok">正常入睡</div><div class="chip warn">入睡困难</div><div class="chip warn">中途醒来</div><div class="chip warn">未午睡</div>
      </div>
      <input type="text" id="note_nap" class="dim-note" placeholder="补充说明（选填），如：要老师拍背才睡着，睡得很沉">
      <div class="row2" style="margin-top:8px">
        <div><input type="text" id="napStart" placeholder="开始 12:30"></div>
        <div><input type="text" id="napEnd" placeholder="结束 14:20"></div>
      </div>

