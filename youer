 const raw=document.getElementById('piText').value||'';
 const lines=raw.split('\n').map(s=>s.trim()).filter(Boolean);
 const st=document.getElementById('piStatus');
 if(!lines.length){st.textContent='请先粘贴内容（每行一条）。';toast('没有可导入的内容');return;}
 DB.phrases=DB.phrases||{};DB.phrases[field]=DB.phrases[field]||{};
 const cur=DB.phrases[field][value]||[];
 const base=Array.isArray(PH[field][value])?PH[field][value]:[PH[field][value]];
 const existed={};
 base.forEach(s=>existed[s]=1);cur.forEach(s=>existed[s]=1);
 let added=0,skipped=0;
 lines.forEach(s=>{if(existed[s]){skipped++;}else{existed[s]=1;cur.push(s);added++;}});
 if(added){DB.phrases[field][value]=cur;save();}
 const label=(PHRASE_FIELDS.find(x=>x[0]===field)||[])[1]||field;
 st.textContent=`已导入 ${added} 条到「${label} / ${value}」${skipped?`（${skipped} 条重复已跳过）`:''}。当前该值共 ${cur.length+base.length} 条措辞可用。`;
