let batchFilter='all';
function renderBatch(){
 const list=document.getElementById('batchList');list.innerHTML='';
 const bh=document.getElementById('batchDateHint');
 if(bh)bh.innerHTML=curDate===today()?'当前批量范围：<b>'+curDate+'（今天）</b>'
  :'⚠️ 当前批量范围：<b>'+curDate+'</b>（非今天）· <a href="javascript:backToday()" style="color:var(--brand)">切回今天</a>';
 const items=DB.kids.map(k=>({k,r:DB.records[key(k.id)]})).filter(x=>x.r);
 document.getElementById('batchCount').textContent=items.length+' 条';
 const order={red:0,yellow:1,green:2};
 items.sort((a,b)=>order[levelOf(a.r)]-order[levelOf(b.r)]);
 // 文案轮换索引按全量排序位置固定，筛选时措辞不会跳变
 items.forEach((x,i)=>{x.gi=i;});
 const red=items.filter(x=>levelOf(x.r)==='red').length,yel=items.filter(x=>levelOf(x.r)==='yellow').length,grn=items.length-red-yel;
 const noRec=DB.kids.length-items.length;
 const CATS=[['red',red,'标红·逐条核对','var(--red)'],['yellow',yel,'标黄·建议看一眼','var(--yellow)'],['green',grn,'标绿·可批量','var(--green)'],['none',noRec,'未录入','var(--sub)']];
 const stat=document.getElementById('batchStat');
 stat.innerHTML=CATS.map(([id,n,lb,color])=>`
  <div class="s${batchFilter===id?' sel':''}" onclick="setBatchFilter('${id}')">
   <div class="n" style="color:${color}">${n}</div><div class="l">${lb}</div></div>`).join('');
 // 「未录入」分类：列出还没录入的孩子，方便去补录
 if(batchFilter==='none'){
  const miss=DB.kids.filter(k=>!DB.records[key(k.id)]);
  if(!miss.length){list.innerHTML='<div class="empty">全部孩子都已录入 ✅</div>';return;}
  list.innerHTML=`<div class="hint" style="margin-bottom:8px">还有 <b>${miss.length}</b> 个孩子未录入（${curDate}）。点「去录入」可直接补录。</div>`;
  miss.forEach(k=>{
   const d=document.createElement('div');d.className='batch-item';
   d.innerHTML=`<div class="hd"><span class="nm">⚪ ${k.name}${k.nickname?' <span class="tag b-purple">'+k.nickname+'</span>':''}</span><span class="tag b-blue">${k.parent}</span></div>
    <div class="ops"><button class="btn btn-sm btn-p" onclick="jumpEdit('${k.id}')">✏️ 去录入</button></div>`;
   list.appendChild(d);
  });
  return;
 }
 if(!items.length){list.innerHTML='<div class="empty">今天还没有录入记录。去「录入」页点选吧。</div>';return;}
 const shown=batchFilter==='all'?items:items.filter(x=>levelOf(x.r)===batchFilter);
 if(!shown.length){
  const nm={red:'标红',yellow:'标黄',green:'标绿'}[batchFilter];
  list.innerHTML=`<div class="empty">当前没有${nm}条目 ✅</div>`;return;
 }
 if(batchFilter!=='all'){
  const tip={red:'🔒 标红条目涉及外伤/发热/冲突/异常，<b>禁止批量发送</b>，请逐条核对后单独复制。',yellow:'🟡 这些条目有需要关注的地方，发送前建议再看一眼。',green:'🟢 这些条目可以批量复制发送。'}[batchFilter];
  list.innerHTML=`<div class="hint" style="margin-bottom:8px">${tip} 当前显示 <b>${shown.length}</b> 条 · <a href="javascript:setBatchFilter('all')" style="color:var(--brand)">看全部</a></div>`;
 }
 shown.forEach(({k,r,gi})=>{
  const lv=levelOf(r);
  const d=document.createElement('div');d.className='batch-item '+lv;
  const ic=lv==='red'?'🔴':lv==='yellow'?'🟡':'🟢';
  d.innerHTML=`<div class="hd"><span class="nm">${ic} ${k.name}${k.nickname?' <span class="tag b-purple">'+k.nickname+'</span>':''}</span><span class="tag b-blue">${k.parent}</span>${r.sent?'<span class="tag b-green">已发送</span>':''}</div>
   <div class="txt">${generate(k,r,gi).replace(/\n/g,'<br>')}</div>
   <div class="ops">
     <button class="btn btn-sm btn-g" onclick="copyOne('${k.id}',${gi})">📋 复制这条</button>
     <button class="btn btn-sm" onclick="jumpEdit('${k.id}')">✏️ 去修改录入</button>
   </div>`;
  list.appendChild(d);
 });
}
function setBatchFilter(f){
 batchFilter=(batchFilter===f)?'all':f;
 renderBatch();
 const nm={all:'全部',red:'标红',yellow:'标黄',green:'标绿',none:'未录入'}[batchFilter];
