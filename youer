let curWeek=null,weekKid=null,allWeeklyCache=[];
function fmtD(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function mondayOf(ds){const d=new Date(ds+'T00:00:00');const day=(d.getDay()+6)%7;d.setDate(d.getDate()-day);return d;}
function weekDates(mon){const d=new Date(mon+'T00:00:00');const arr=[];for(let i=0;i<7;i++){arr.push(fmtD(d));d.setDate(d.getDate()+1);}return arr;}
function getWeeks(){const set=new Set();Object.keys(DB.records).forEach(k=>set.add(fmtD(mondayOf(k.split('_')[0]))));set.add(fmtD(mondayOf(today())));return [...set].sort().reverse();}
function kidWeekRecords(kidId,mon){return weekDates(mon).map(ds=>({ds,r:DB.records[ds+'_'+kidId]})).filter(x=>x.r);}
function mode(arr){if(!arr.length)return null;const c={};arr.forEach(x=>c[x]=(c[x]||0)+1);return Object.keys(c).sort((a,b)=>c[b]-c[a])[0];}

function aggregateWeek(k,items){
 const days=items.length;
 const present=items.filter(x=>x.r.attendance==='正常出勤').length;
 const lunchMode=mode(items.map(x=>x.r.lunch).filter(Boolean));
 const picks=[...new Set(items.flatMap(x=>x.r.pick||[]).filter(p=>p!=='无'))];
 const stoolDays=items.filter(x=>x.r.stoolCount&&x.r.stoolCount!=='0次').length;
 const naps=items.map(x=>napMinutes(x.r)).filter(n=>n!=null);
 const napAvg=naps.length?Math.round(naps.reduce((a,b)=>a+b,0)/naps.length):null;
 const moodOk=items.filter(x=>['愉快','平静'].includes(x.r.mood)).length;
 const socialMode=mode(items.map(x=>x.r.social).filter(Boolean));
 const actCount={};items.forEach(x=>(x.r.activity||[]).forEach(a=>actCount[a]=(actCount[a]||0)+1));
 const topActs=Object.keys(actCount).sort((a,b)=>actCount[b]-actCount[a]).slice(0,2);
 const highlights=items.map(x=>({ds:x.ds.slice(5),h:x.r.highlight})).filter(x=>x.h).slice(0,3);
 const attentions=[...new Set(items.map(x=>x.r.attention).filter(Boolean))];
 const injuries=items.filter(x=>x.r.injury==='有');
 return {days,present,lunchMode,picks,stoolDays,napAvg,moodOk,socialMode,topActs,highlights,attentions,injuries};
}
function generateWeekly(k,items,mon){
 const a=aggregateWeek(k,items);
 const dnm=displayName(k);
 const d=weekDates(mon);
 const label=d[0].slice(5).replace('-','/')+' ~ '+d[6].slice(5).replace('-','/');
 const L=[];
 L.push(`${k.name} · ${label} 周评`,'');
 L.push(`${k.parent}好，这周${dnm}的情况给您做个小结。`,'');
 const kw=[];
 kw.push(a.present===a.days&&a.days>=4?'全勤':`本周到园 ${a.present} 天`);
 const lunchKw={'全部吃完':'胃口很好','吃了大半':'胃口不错','吃了一半':'胃口一般','少量':'胃口偏弱','未进食':'胃口偏弱'};
 if(a.lunchMode)kw.push(lunchKw[a.lunchMode]);
 const socialKw={'主动合作':'社交有进步','被动跟随':'和同伴玩得融洽','独处':'喜欢自己玩','有冲突':'与同伴有些小摩擦'};
 if(a.socialMode)kw.push(socialKw[a.socialMode]);
 L.push(`【本周总览】${kw.filter(Boolean).join('、')}。`,'');
 let dn='';
 if(a.days<2)dn='本周数据较少，暂不做小结。';
 else{
  const lunchDesc={'全部吃完':'基本都能光盘','吃了大半':'吃了大半','吃了一半':'吃了一半左右','少量':'只吃了一点','未进食':'基本没怎么吃'};
  dn+='吃饭：'+(a.lunchMode?`午餐${lunchDesc[a.lunchMode]}`:'午餐数据较少');
  if(a.picks.length)dn+=`，${a.picks.join('、')}还是不太爱吃`;
  dn+='。';
  dn+=a.napAvg!=null?`午睡平均 ${Math.floor(a.napAvg/60)} 小时 ${a.napAvg%60} 分。`:'午睡数据较少。';
  dn+=`排便规律 ${a.stoolDays} 天。`;
 }
 L.push(`【饮食作息】${dn}`);
 let es='';
 if(a.days<2)es='本周数据较少，暂不做小结。';
 else{
  es=`情绪：${a.days} 天里 ${a.moodOk} 天状态不错。`;
  const socialDesc={'主动合作':'主动和小朋友一起玩，有合作意识','被动跟随':'跟着小朋友一起玩','独处':'更喜欢自己玩一会儿','有冲突':'和小朋友有过小摩擦，我们都及时引导了'};
  if(a.socialMode)es+=`社交：${socialDesc[a.socialMode]}。`;
 }
 L.push(`【情绪与社交】${es}`);
 let ac='';
 if(a.days<2)ac='本周数据较少，暂不做小结。';
 else ac=a.topActs.length?`最喜欢${a.topActs.join('和')}。`:'活动偏好暂不明显。';
 L.push(`【活动与兴趣】${ac}`,'');
 if(a.highlights.length){
  L.push('【成长亮点】');
  a.highlights.forEach((h,i)=>L.push(`${i+1}. （${h.ds}）${h.h}`));
 }else L.push('【成长亮点】本周未记录到具体事例，下周我们会多观察。');
 L.push('');
 let sug='';
 if(a.picks.includes('蔬菜'))sug='青菜接受度还在努力，我们继续用"一口就好"的方式引导，家里也可以同步试试。';
 else if(a.stoolDays<a.days*0.6)sug=`本周有 ${a.days-a.stoolDays} 天没有排便记录，建议多补充膳食纤维和水分。`;
 else if(a.napAvg!=null&&a.napAvg<60)sug='午睡时长偏短，建议晚上适当早点休息。';
 else if(a.moodOk<a.days*0.6)sug='本周情绪波动略多，我们会在园多观察原因，也请家里多和孩子聊聊。';
 else sug='保持现在的节奏就好，期待下周。';
 L.push(`【一条建议】${sug}`,'');
 if(a.attentions.length)L.push(`【需关注事项】${a.attentions.join('；')}`,'');
 if(a.injuries.length)L.push(`【备注】本周有 ${a.injuries.length} 次轻微外伤，当时已单独与家长同步。`,'');
 L.push('—— 老师');
 return L.join('\n');
}
