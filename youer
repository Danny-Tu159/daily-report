function applyRosterImport(){
 if(!rosterPending){closeRosterModal();return;}
 const cur={};DB.kids.forEach(k=>cur[k.name]=k);
 let add=0,upd=0,nkSet=0;
 rosterPending.forEach(x=>{
  if(!cur[x.name]){
   const kid={id:'C'+Date.now().toString(36)+Math.floor(Math.random()*999),name:x.name,parent:x.parent||x.name+'妈妈'};
   if(x.nickname){kid.nickname=x.nickname;nkSet++;}
   DB.kids.push(kid);
   add++;
  }else if(rosterMode!=='仅新增'){
   let ch=false;
   if(x.parent&&cur[x.name].parent!==x.parent){cur[x.name].parent=x.parent;ch=true;}
   if(x.nickname&&cur[x.name].nickname!==x.nickname){cur[x.name].nickname=x.nickname;nkSet++;ch=true;}
   if(ch)upd++;
  }
 });
 let rm=0;
 if(rosterMode==='以表格为准'){
  const inSheet={};rosterPending.forEach(x=>inSheet[x.name]=1);
  const gone=DB.kids.filter(k=>!inSheet[k.name]);
  gone.forEach(k=>{Object.keys(DB.records).forEach(rk=>{if(rk.endsWith('_'+k.id))delete DB.records[rk];});});
  DB.kids=DB.kids.filter(k=>inSheet[k.name]);
  rm=gone.length;
 }
 save();closeRosterModal();renderRoster();rosterPending=null;
 toast(`导入完成：新增 ${add} 人${upd?`，更新 ${upd} 人`:''}${nkSet?`，设置小名 ${nkSet} 人`:''}${rm?`，移除 ${rm} 人`:''}`);
}

