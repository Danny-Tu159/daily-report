/* ===== 日报生成 ===== */
function napMinutes(r){
 if(!r.napStart||!r.napEnd)return null;
 const p=(s)=>{const m=s.match(/(\d{1,2})[:：](\d{2})/);return m?parseInt(m[1])*60+parseInt(m[2]):null;};
 const a=p(r.napStart),b=p(r.napEnd);return(a&&b&&b>a)?b-a:null;
}
function generate(k,r,gIdx){
 const dn=displayName(k);
 const g=GREETS[gIdx%GREETS.length].replace('{p}',k.parent).replace('{n}',dn).replace('{d}',today().slice(5).replace('-','月')+'日');
 const nt=(f)=>r['note_'+f]?`（${r['note_'+f]}）`:'';
 let lines=[g,''];
 const ep=pickPh('energy',r.energy,gIdx);
 lines.push(`${dn}${ep.startsWith('今天')?'':'今天'}${ep}。${pickPh('mood',r.mood,gIdx)}。${nt('energy')}${nt('mood')}`);
 let meal=`吃饭方面，早餐${pickPh('meal',r.breakfast,gIdx)}${nt('breakfast')}，午餐${pickPh('meal',r.lunch,gIdx)}${nt('lunch')}`;
 const picks=(r.pick||[]).filter(x=>x!=='无');
 if(picks.length)meal+=`（${picks.join('、')}剩了些${nt('pick')}）`;
 meal+=`。${pickPh('snack',r.snack,gIdx)}${nt('snack')}。`;
 lines.push(meal);
 const sp=pickPh('stool',r.stoolStatus,gIdx);
 // 短语自带「排便/大便」主语时去掉，避免「排便1次，排便正常」这类重复
 const spClean=sp.replace(/^(排便|大便)/,'');
 let stool=`排便${r.stoolCount||''}${nt('stoolCount')}，${spClean}${nt('stoolStatus')}。`;
 lines.push(stool);
 const np=pickPh('nap',r.nap,gIdx);
 let nap=`${(/^(午睡|今天|中午)/.test(np))?'':'午睡'}${np}${nt('nap')}`;
 const nm=napMinutes(r);
 if(r.napStart&&r.napEnd)nap+=`（${r.napStart}–${r.napEnd}`+(nm?`，${Math.floor(nm/60)}小时${nm%60}分`:'')+`）`;
 nap+='。';
 lines.push(nap);
 let act='';
 const acts=(r.activity||[]);
 if(acts.length)act+=`活动上玩了${acts.join('、')}${nt('activity')}。`;
 act+=`社交方面${pickPh('social',r.social,gIdx)}${nt('social')}。`;
 lines.push(act);
 if(r.highlight)lines.push(`今天的小亮点：${r.highlight} 😊`);
 if(r.injury==='有'){
  lines.push('');lines.push(`⚠️ 身体情况需要同步：${r.injuryText}`);
 }else if(r.temp||r.symptom){
  let h='身体情况：';
  if(r.temp)h+=`体温 ${r.temp}℃`;
  if(r.symptom)h+=(r.temp?'，':'')+`有${r.symptom}`;
  h+='，我们会持续观察。';
  lines.push(h);
 }else{
  lines.push('身体情况一切正常，没有不适。');
 }
 if(r.attention){lines.push('');lines.push(`小提示：${r.attention}`);}
 lines.push('');lines.push('—— 老师');
 return lines.join('\n');
}
