// 简易 CSV/TSV 解析（支持引号包裹的字段与逗号）
function parseDelimited(text){
 const delim=(text.indexOf('\t')>=0&&text.split('\t').length>=text.split(',').length)?'\t':',';
 const rows=[];let cur=[],field='',inQ=false;
 for(let i=0;i<text.length;i++){
  const ch=text[i];
  if(inQ){
   if(ch==='"'){if(text[i+1]==='"'){field+='"';i++;}else inQ=false;}
   else field+=ch;
  }else{
   if(ch==='"')inQ=true;
   else if(ch===delim){cur.push(field);field='';}
   else if(ch==='\n'){cur.push(field);rows.push(cur);cur=[];field='';}
   else if(ch==='\r'){}
   else field+=ch;
  }
 }
 cur.push(field);rows.push(cur);
 return rows.map(r=>r.map(s=>(s||'').trim())).filter(r=>r.some(s=>s));
}

// ZIP 中央目录解析
function zipEntries(buf){
 const u8=new Uint8Array(buf);const dv=new DataView(buf);
 let eocd=-1;
 for(let i=u8.length-22;i>=Math.max(0,u8.length-66000);i--){
  if(dv.getUint32(i,true)===0x06054b50){eocd=i;break;}
 }
 if(eocd<0)throw new Error('不是有效的 xlsx 文件（未找到 ZIP 目录）');
 const count=dv.getUint16(eocd+10,true);
 let off=dv.getUint32(eocd+16,true);
 const out=[];
 for(let n=0;n<count;n++){
  if(dv.getUint32(off,true)!==0x02014b50)break;
  const method=dv.getUint16(off+10,true);
  const compSize=dv.getUint32(off+20,true);
  const nameLen=dv.getUint16(off+28,true);
  const extraLen=dv.getUint16(off+30,true);
  const cmtLen=dv.getUint16(off+32,true);
  const lho=dv.getUint32(off+42,true);
  let name='';for(let j=0;j<nameLen;j++)name+=String.fromCharCode(u8[off+46+j]);
  out.push({name,method,compSize,lho});
  off+=46+nameLen+extraLen+cmtLen;
 }
 return out;
}

// 从本地头取数据起点，并用 DecompressionStream 解压
async function zipRead(buf,entry){
 const u8=new Uint8Array(buf);const dv=new DataView(buf);
 const lho=entry.lho;
 if(dv.getUint32(lho,true)!==0x04034b50)throw new Error('ZIP 本地头损坏');
 const nameLen=dv.getUint16(lho+26,true),extraLen=dv.getUint16(lho+28,true);
 const start=lho+30+nameLen+extraLen;
 const data=u8.subarray(start,start+entry.compSize);
 if(entry.method===0)return new TextDecoder('utf-8').decode(data);
 if(entry.method!==8)throw new Error('不支持的压缩方式');
 const ds=new DecompressionStream('deflate-raw');
 const blob=new Blob([data]).stream().pipeThrough(ds);
 return await new Response(blob).text();
}

// 读取 xlsx 第一个工作表 -> 二维数组
async function parseXlsx(buf){
 const entries=zipEntries(buf);
 // 共享字符串表（可能存在）
 let shared=[];
 const ss=entries.find(e=>/sharedStrings\.xml$/i.test(e.name));
 if(ss){
  const xml=await zipRead(buf,ss);
  const doc=new DOMParser().parseFromString(xml,'application/xml');
  [...doc.getElementsByTagName('si')].forEach(si=>{
   let t='';
   [...si.getElementsByTagName('t')].forEach(n=>t+=n.textContent);
   shared.push(t);
  });
 }
 const sheet=entries.find(e=>/worksheets\/sheet\d+\.xml$/i.test(e.name))
            ||entries.find(e=>/worksheets\/[^\/]+\.xml$/i.test(e.name));
 if(!sheet)throw new Error('xlsx 里没找到工作表');
 const sxml=await zipRead(buf,sheet);
 const sdoc=new DOMParser().parseFromString(sxml,'application/xml');
 const rows=[];
 [...sdoc.getElementsByTagName('row')].forEach(row=>{
  const arr=[];
  [...row.getElementsByTagName('c')].forEach(c=>{
   const type=c.getAttribute('t');
   const vNode=c.getElementsByTagName('v')[0];
   const isNode=c.getElementsByTagName('is')[0];
   let val='';
   if(type==='inlineStr'&&isNode){[...isNode.getElementsByTagName('t')].forEach(n=>val+=n.textContent);}
   else if(vNode){
    val=vNode.textContent;
    if(type==='s')val=shared[parseInt(val,10)]||'';
   }
   arr.push((val||'').trim());
  });
  rows.push(arr);
 });
 return rows.filter(r=>r.some(s=>s));
}

// 跳过表头行：若首行含"姓名/名字/幼儿"等字样则视为表头
function stripHeader(rows){
 if(!rows.length)return rows;
 const h=(rows[0][0]||'')+(rows[0][1]||'');
 if(/姓名|名字|幼儿|儿童|家长|称呼|序号|学号|班级/.test(h))return rows.slice(1);
 return rows;
}

function importRosterFile(e){
 const f=e.target.files[0];
 if(!f)return;
 const isXlsx=/\.(xlsx|xls)$/i.test(f.name);
 if(isXlsx&&typeof DecompressionStream==='undefined'){
  toast('当前浏览器不支持 xlsx 解析，请改用 csv 或用「批量粘贴」');
  e.target.value='';return;
 }
 const rd=new FileReader();
 rd.onload=async()=>{
  try{
   let rows;
   if(isXlsx){rows=await parseXlsx(rd.result);}
   else{rows=parseDelimited(rd.result);}
   rows=stripHeader(rows);
   if(!rows.length){toast('表格是空的');e.target.value='';return;}
   rosterPending=rows.map(r=>({name:(r[0]||'').trim(),parent:(r[1]||'').trim(),nickname:(r[2]||'').trim()})).filter(x=>x.name);
   if(!rosterPending.length){toast('表格里第一列没读到姓名');e.target.value='';return;}
   openRosterModal();
  }catch(err){toast('读取失败：'+err.message);}
  e.target.value='';
 };
 if(isXlsx)rd.readAsArrayBuffer(f);else rd.readAsText(f,'UTF-8');
}

